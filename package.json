{
  "name": "hubchat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @hubchat/dashboard dev",
    "dev:dashboard": "pnpm --filter @hubchat/dashboard dev",
    "dev:portal": "pnpm --filter @hubchat/portal dev",
    "dev:widget": "pnpm --filter @hubchat/widget dev",
    "build": "pnpm -r --filter \"./web/*\" build",
    "typecheck": "pnpm -r --filter \"./web/*\" typecheck",
    "lint": "pnpm -r --filter \"./web/*\" lint",
    "clean": "rm -rf web/*/dist web/*/node_modules node_modules"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
