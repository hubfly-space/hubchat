{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Hubchat API",
    "version": "1.0.0",
    "description": "The versioned, workspace-scoped REST contract for Hubchat. Browser sessions use cookies; server integrations use a workspace-scoped API key as a Bearer token."
  },
  "servers": [{ "url": "/api", "description": "The Hubchat API mounted by the application" }],
  "externalDocs": { "description": "API conventions and compatibility policy", "url": "/docs/api-conventions.md" },
  "security": [{ "bearerAuth": [] }],
  "tags": [
    { "name": "Conversations", "description": "Shared inbox conversations and messages" },
    { "name": "Tickets", "description": "Tracked support requests" },
    { "name": "Customers", "description": "Customer records and events" },
    { "name": "Files", "description": "Authorized attachment storage" },
    { "name": "Forms", "description": "Structured forms and submissions" },
    { "name": "Feedback", "description": "Boards, ideas, votes, and subscriptions" },
    { "name": "Knowledge base", "description": "Articles, collections, and public search" },
    { "name": "Surveys", "description": "Survey delivery and response collection" },
    { "name": "Automation", "description": "Deterministic rules, macros, and saved replies" },
    { "name": "SLA", "description": "Calendars, policies, and timer instances" },
    { "name": "Integrations", "description": "API keys, webhooks, and event delivery" },
    { "name": "Analytics", "description": "Metric definitions, rollups, and reports" },
    { "name": "Portability", "description": "Workspace export and import jobs" },
    { "name": "Portal", "description": "Customer portal sessions and profile" }
  ],
  "paths": {
    "/v1/meta": {
      "get": { "operationId": "getMeta", "security": [], "tags": ["Integrations"], "responses": { "200": { "$ref": "#/components/responses/Json" } } }
    },
    "/v1/audit-logs": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listAuditLogs", "tags": ["Integrations"] }
    },
    "/v1/audit-logs/export.csv": {
      "get": { "summary": "Export audit logs as CSV", "operationId": "exportAuditLogs", "tags": ["Integrations"], "responses": { "200": { "description": "Workspace-scoped audit CSV", "content": { "text/csv": { "schema": { "type": "string" } } } }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/workspace/usage": {
      "get": { "$ref": "#/components/operations/get", "operationId": "getWorkspaceUsage", "tags": ["Analytics"] }
    },
    "/v1/conversations": {
      "get": { "$ref": "#/components/operations/list" , "operationId": "listConversations", "tags": ["Conversations"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createConversation", "tags": ["Conversations"] }
    },
    "/v1/saved-views": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listSavedViews", "tags": ["Conversations"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createSavedView", "tags": ["Conversations"] }
    },
    "/v1/saved-views/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/get", "operationId": "getSavedView", "tags": ["Conversations"] },
      "patch": { "$ref": "#/components/operations/update", "operationId": "updateSavedView", "tags": ["Conversations"] },
      "delete": { "$ref": "#/components/operations/delete", "operationId": "deleteSavedView", "tags": ["Conversations"] }
    },
    "/v1/conversations/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/get", "operationId": "getConversation", "tags": ["Conversations"] },
      "patch": { "$ref": "#/components/operations/update", "operationId": "updateConversation", "tags": ["Conversations"] }
    },
    "/v1/conversations/{id}/ticket": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": { "$ref": "#/components/operations/create", "operationId": "convertConversationToTicket", "tags": ["Tickets"] }
    },
    "/v1/conversations/{id}/messages": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/list", "operationId": "listConversationMessages", "tags": ["Conversations"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createConversationMessage", "tags": ["Conversations"] }
    },
    "/v1/tickets": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listTickets", "tags": ["Tickets"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createTicket", "tags": ["Tickets"] }
    },
    "/v1/tickets/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/get", "operationId": "getTicket", "tags": ["Tickets"] },
      "patch": { "$ref": "#/components/operations/update", "operationId": "updateTicket", "tags": ["Tickets"] }
    },
    "/v1/customers": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listCustomers", "tags": ["Customers"] }
    },
    "/v1/customers/export": {
      "get": { "summary": "Export customers as CSV", "operationId": "exportCustomers", "tags": ["Customers"], "responses": { "200": { "description": "Workspace-scoped customer CSV", "content": { "text/csv": { "schema": { "type": "string" } } } }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/customers/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/get", "operationId": "getCustomer", "tags": ["Customers"] },
      "patch": { "$ref": "#/components/operations/update", "operationId": "updateCustomer", "tags": ["Customers"] }
    },
    "/v1/events": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listEvents", "tags": ["Customers"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createEvent", "tags": ["Customers"] }
    },
    "/v1/companies/export": {
      "get": { "summary": "Export companies as CSV", "operationId": "exportCompanies", "tags": ["Customers"], "responses": { "200": { "description": "Workspace-scoped company CSV", "content": { "text/csv": { "schema": { "type": "string" } } } }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/files": {
      "post": {
        "operationId": "uploadFile", "tags": ["Files"], "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string", "format": "binary" }, "owner_type": { "type": "string" }, "owner_id": { "$ref": "#/components/schemas/Id" } } } } } },
        "responses": { "201": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/files/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "operationId": "downloadFile", "tags": ["Files"], "responses": { "200": { "description": "Binary file contents", "content": { "application/octet-stream": { "schema": { "type": "string", "format": "binary" } } } }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/forms": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listForms", "tags": ["Forms"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createForm", "tags": ["Forms"] }
    },
    "/v1/forms/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/get", "operationId": "getForm", "tags": ["Forms"] },
      "patch": { "$ref": "#/components/operations/update", "operationId": "updateForm", "tags": ["Forms"] },
      "delete": { "$ref": "#/components/operations/delete", "operationId": "deleteForm", "tags": ["Forms"] }
    },
    "/v1/public/forms/{workspaceID}/{slug}": {
      "parameters": [{ "$ref": "#/components/parameters/WorkspaceID" }, { "$ref": "#/components/parameters/Slug" }],
      "get": { "$ref": "#/components/operations/publicGet", "operationId": "getPublicForm", "security": [], "tags": ["Forms"] }
    },
    "/v1/public/forms/{workspaceID}/{slug}/files": {
      "parameters": [{ "$ref": "#/components/parameters/WorkspaceID" }, { "$ref": "#/components/parameters/Slug" }],
      "post": {
        "operationId": "uploadPublicFormFile", "security": [], "tags": ["Forms"],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string", "format": "binary" } } } } } },
        "responses": { "201": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/public/forms/{workspaceID}/{slug}/submissions": {
      "parameters": [{ "$ref": "#/components/parameters/WorkspaceID" }, { "$ref": "#/components/parameters/Slug" }],
      "post": { "$ref": "#/components/operations/publicCreate", "operationId": "submitPublicForm", "security": [], "tags": ["Forms"] }
    },
    "/v1/feedback/boards": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listFeedbackBoards", "tags": ["Feedback"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createFeedbackBoard", "tags": ["Feedback"] }
    },
    "/v1/feedback/boards/{id}/items": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/list", "operationId": "listFeedbackItems", "tags": ["Feedback"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createFeedbackItem", "tags": ["Feedback"] }
    },
    "/v1/feedback/items/{id}/links": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/list", "operationId": "listFeedbackLinks", "tags": ["Feedback"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "linkFeedbackSupportWork", "tags": ["Feedback"] }
    },
    "/v1/feedback/items/{id}/links/{linkID}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/LinkID" }],
      "delete": { "$ref": "#/components/operations/delete", "operationId": "unlinkFeedbackSupportWork", "tags": ["Feedback"] }
    },
    "/v1/feedback/items/{id}/merge": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": { "$ref": "#/components/operations/create", "operationId": "mergeFeedbackItem", "tags": ["Feedback"] }
    },
    "/v1/public/feedback/{workspaceID}/boards/{slug}/items": {
      "parameters": [{ "$ref": "#/components/parameters/WorkspaceID" }, { "$ref": "#/components/parameters/Slug" }],
      "get": { "$ref": "#/components/operations/publicList", "operationId": "listPublicFeedbackItems", "security": [], "tags": ["Feedback"] },
      "post": { "$ref": "#/components/operations/publicCreate", "operationId": "createPublicFeedbackItem", "security": [], "tags": ["Feedback"] }
    },
    "/v1/public/feedback/{workspaceID}/items/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/WorkspaceID" }, { "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/publicGet", "operationId": "getPublicFeedbackItem", "security": [], "tags": ["Feedback"] }
    },
    "/v1/public/feedback/{workspaceID}/items/{id}/comments": {
      "parameters": [{ "$ref": "#/components/parameters/WorkspaceID" }, { "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/publicList", "operationId": "listPublicFeedbackComments", "security": [], "tags": ["Feedback"] },
      "post": { "$ref": "#/components/operations/publicCreate", "operationId": "createPublicFeedbackComment", "security": [], "tags": ["Feedback"] }
    },
    "/v1/public/feedback/{workspaceID}/items/{id}/subscription": {
      "parameters": [{ "$ref": "#/components/parameters/WorkspaceID" }, { "$ref": "#/components/parameters/Id" }],
      "post": { "$ref": "#/components/operations/publicCreate", "operationId": "subscribeToFeedbackItem", "security": [], "tags": ["Feedback"] },
      "delete": { "$ref": "#/components/operations/publicDelete", "operationId": "unsubscribeFromFeedbackItem", "security": [], "tags": ["Feedback"] }
    },
    "/v1/knowledge-bases": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listKnowledgeBases", "tags": ["Knowledge base"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createKnowledgeBase", "tags": ["Knowledge base"] }
    },
    "/v1/articles": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listArticles", "tags": ["Knowledge base"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createArticle", "tags": ["Knowledge base"] }
    },
    "/v1/articles/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/get", "operationId": "getArticle", "tags": ["Knowledge base"] },
      "patch": { "$ref": "#/components/operations/update", "operationId": "updateArticle", "tags": ["Knowledge base"] }
    },
    "/v1/articles/{id}/revisions": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/list", "operationId": "listArticleRevisions", "tags": ["Knowledge base"] }
    },
    "/v1/public/knowledge-bases/{workspaceID}/search": {
      "parameters": [{ "$ref": "#/components/parameters/WorkspaceID" }],
      "get": { "$ref": "#/components/operations/publicList", "operationId": "searchPublicArticles", "security": [], "tags": ["Knowledge base"] }
    },
    "/v1/changelog": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listChangelogEntries", "tags": ["Knowledge base"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createChangelogEntry", "tags": ["Knowledge base"] }
    },
    "/v1/changelog/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/get", "operationId": "getChangelogEntry", "tags": ["Knowledge base"] },
      "patch": { "$ref": "#/components/operations/update", "operationId": "updateChangelogEntry", "tags": ["Knowledge base"] }
    },
    "/v1/changelog/{id}/publish": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": { "$ref": "#/components/operations/publicCreate", "operationId": "publishChangelogEntry", "tags": ["Knowledge base"] }
    },
    "/v1/public/changelog/{workspaceID}": {
      "parameters": [{ "$ref": "#/components/parameters/WorkspaceID" }],
      "get": { "$ref": "#/components/operations/publicList", "operationId": "listPublicChangelogEntries", "security": [], "tags": ["Knowledge base"] }
    },
    "/v1/surveys": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listSurveys", "tags": ["Surveys"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createSurvey", "tags": ["Surveys"] }
    },
    "/v1/surveys/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/get", "operationId": "getSurvey", "tags": ["Surveys"] },
      "patch": { "$ref": "#/components/operations/update", "operationId": "updateSurvey", "tags": ["Surveys"] }
    },
    "/v1/surveys/{id}/responses": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/list", "operationId": "listSurveyResponses", "tags": ["Surveys"] }
    },
    "/v1/surveys/{id}/responses.csv": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/list", "operationId": "exportSurveyResponses", "tags": ["Surveys"] }
    },
    "/v1/public/surveys/{workspaceID}/{id}/responses": {
      "parameters": [{ "$ref": "#/components/parameters/WorkspaceID" }, { "$ref": "#/components/parameters/Id" }],
      "post": { "$ref": "#/components/operations/publicCreate", "operationId": "submitSurveyResponse", "security": [], "tags": ["Surveys"] }
    },
    "/v1/automation/rules": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listAutomationRules", "tags": ["Automation"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createAutomationRule", "tags": ["Automation"] }
    },
    "/v1/automation/rules/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/get", "operationId": "getAutomationRule", "tags": ["Automation"] },
      "patch": { "$ref": "#/components/operations/update", "operationId": "updateAutomationRule", "tags": ["Automation"] }
    },
    "/v1/automation/executions": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listAutomationExecutions", "tags": ["Automation"] }
    },
    "/v1/sla/calendars": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listSLACalendars", "tags": ["SLA"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createSLACalendar", "tags": ["SLA"] }
    },
    "/v1/jobs": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listJobs", "tags": ["Integrations"] }
    },
    "/v1/jobs/summary": {
      "get": { "$ref": "#/components/operations/get", "operationId": "getJobSummary", "tags": ["Integrations"] }
    },
    "/v1/ops/summary": {
      "get": { "$ref": "#/components/operations/get", "operationId": "getOperationalSummary", "tags": ["Integrations"] }
    },
    "/v1/sla/calendars/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/get", "operationId": "getSLACalendar", "tags": ["SLA"] },
      "patch": { "$ref": "#/components/operations/update", "operationId": "updateSLACalendar", "tags": ["SLA"] }
    },
    "/v1/sla/policies": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listSLAPolicies", "tags": ["SLA"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createSLAPolicy", "tags": ["SLA"] }
    },
    "/v1/sla/instances": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listSLAInstances", "tags": ["SLA"] }
    },
    "/v1/api-keys": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listAPIKeys", "tags": ["Integrations"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createAPIKey", "tags": ["Integrations"] }
    },
    "/v1/webhooks": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listWebhooks", "tags": ["Integrations"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createWebhook", "tags": ["Integrations"] }
    },
    "/v1/email/status": {
      "get": { "$ref": "#/components/operations/get", "operationId": "getEmailStatus", "tags": ["Integrations"] }
    },
    "/v1/email/mailboxes": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listEmailMailboxes", "tags": ["Integrations"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createEmailMailbox", "tags": ["Integrations"] }
    },
    "/v1/email/mailboxes/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "patch": { "$ref": "#/components/operations/update", "operationId": "updateEmailMailbox", "tags": ["Integrations"] },
      "delete": { "$ref": "#/components/operations/delete", "operationId": "deleteEmailMailbox", "tags": ["Integrations"] }
    },
    "/v1/email/mailboxes/{id}/delivery-events": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/list", "operationId": "listEmailDeliveryEvents", "tags": ["Integrations"] }
    },
    "/v1/email/mailboxes/{id}/suppressions": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/list", "operationId": "listMailboxEmailSuppressions", "tags": ["Integrations"] }
    },
    "/v1/email/mailboxes/{id}/suppressions/{address}": {
      "parameters": [
        { "$ref": "#/components/parameters/Id" },
        { "name": "address", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "delete": { "$ref": "#/components/operations/delete", "operationId": "removeEmailSuppression", "tags": ["Integrations"] }
    },
    "/v1/email/suppressions": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listEmailSuppressions", "tags": ["Integrations"] }
    },
    "/v1/email/inbound/{provider}": {
      "parameters": [{ "name": "provider", "in": "path", "required": true, "schema": { "type": "string" } }],
      "post": { "$ref": "#/components/operations/publicCreate", "operationId": "receiveInboundEmail", "security": [], "tags": ["Integrations"] }
    },
    "/v1/email/delivery/{provider}/{mailboxID}": {
      "parameters": [
        { "name": "provider", "in": "path", "required": true, "schema": { "type": "string" } },
        { "name": "mailboxID", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": { "$ref": "#/components/operations/publicCreate", "operationId": "receiveEmailDeliveryEvent", "security": [], "tags": ["Integrations"] }
    },
    "/v1/analytics/metrics": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listMetricDefinitions", "tags": ["Analytics"] }
    },
    "/v1/analytics/summary": {
      "get": { "$ref": "#/components/operations/get", "operationId": "getAnalyticsSummary", "tags": ["Analytics"] }
    },
    "/v1/analytics/rollups": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listAnalyticsRollups", "tags": ["Analytics"] }
    },
    "/v1/analytics/export.csv": {
      "get": { "operationId": "exportAnalyticsCsv", "tags": ["Analytics"], "responses": { "200": { "description": "Workspace-scoped analytics CSV", "content": { "text/csv": { "schema": { "type": "string" } } } }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/reports": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listReports", "tags": ["Analytics"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createReport", "tags": ["Analytics"] }
    },
    "/v1/reports/{id}/schedules": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/list", "operationId": "listReportSchedules", "tags": ["Analytics"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createReportSchedule", "tags": ["Analytics"] }
    },
    "/v1/reports/{id}/schedules/{scheduleID}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }, { "name": "scheduleID", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Id" } }],
      "patch": { "$ref": "#/components/operations/update", "operationId": "updateReportSchedule", "tags": ["Analytics"] },
      "delete": { "$ref": "#/components/operations/delete", "operationId": "deleteReportSchedule", "tags": ["Analytics"] }
    },
    "/v1/portability/exports": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listExports", "tags": ["Portability"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createExport", "tags": ["Portability"] }
    },
    "/v1/portability/exports/preview": {
      "post": { "summary": "Preview a workspace export", "operationId": "previewWorkspaceExport", "tags": ["Portability"], "requestBody": { "$ref": "#/components/requestBodies/Json" }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/portability/exports/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/get", "operationId": "getExport", "tags": ["Portability"] }
    },
    "/v1/portability/exports/{id}/manifest": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/get", "operationId": "getExportManifest", "tags": ["Portability"] }
    },
    "/v1/portability/imports": {
      "get": { "$ref": "#/components/operations/list", "operationId": "listImports", "tags": ["Portability"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "createImport", "tags": ["Portability"], "description": "Create a resumable import. Kinds are workspace, customers_csv, companies_csv, tickets_csv, feedback_csv, or knowledgebase_markdown." }
    },
    "/v1/portability/import-files": {
      "post": {
        "operationId": "uploadPortabilityImportFile", "tags": ["Portability"],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string", "format": "binary" } } } } } },
        "responses": { "201": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/portability/imports/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/get", "operationId": "getImport", "tags": ["Portability"] }
    },
    "/v1/portability/imports/{id}/preview": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": { "$ref": "#/components/operations/create", "operationId": "previewImport", "tags": ["Portability"] }
    },
    "/v1/portability/imports/{id}/confirm": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": { "$ref": "#/components/operations/create", "operationId": "confirmImport", "tags": ["Portability"] }
    },
    "/v1/portal/me": {
      "get": { "operationId": "getPortalProfile", "security": [{ "portalCookie": [] }], "tags": ["Portal"], "responses": { "200": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Error" } } },
      "patch": { "$ref": "#/components/operations/portalUpdate", "operationId": "updatePortalProfile", "security": [{ "portalCookie": [] }], "tags": ["Portal"] }
    },
    "/v1/portal/me/export": {
      "get": { "operationId": "exportPortalCustomerData", "security": [{ "portalCookie": [] }], "tags": ["Portal"], "responses": { "200": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/portal/me/delete": {
      "post": { "operationId": "deletePortalCustomerData", "security": [{ "portalCookie": [] }], "tags": ["Portal"], "requestBody": { "$ref": "#/components/requestBodies/Json" }, "responses": { "204": { "description": "Account anonymised and portal sessions revoked" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/portals/{id}/domains": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "$ref": "#/components/operations/list", "operationId": "listPortalDomains", "tags": ["Portal"] },
      "post": { "$ref": "#/components/operations/create", "operationId": "addPortalDomain", "tags": ["Portal"] }
    },
    "/v1/portals/{id}/domains/{domainID}/verify": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }, { "name": "domainID", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Id" } }],
      "post": { "$ref": "#/components/operations/create", "operationId": "verifyPortalDomain", "tags": ["Portal"] }
    },
    "/v1/portals/{id}/domains/{domainID}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }, { "name": "domainID", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Id" } }],
      "delete": { "$ref": "#/components/operations/delete", "operationId": "deletePortalDomain", "tags": ["Portal"] }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "hc_live_...", "description": "Workspace-scoped API key. The complete token is shown only once." },
      "portalCookie": { "type": "apiKey", "in": "cookie", "name": "hubchat_portal_session", "description": "HttpOnly customer portal session cookie." }
    },
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Id" } },
      "LinkID": { "name": "linkID", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Id" } },
      "WorkspaceID": { "name": "workspaceID", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Id" } },
      "Slug": { "name": "slug", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$" } },
      "Cursor": { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Opaque cursor returned as next_cursor." },
      "Limit": { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string", "minLength": 8 }, "description": "Recommended for every retryable create or action." }
    },
    "operations": {
      "list": { "summary": "List resources", "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Error" } } },
      "get": { "summary": "Get a resource", "responses": { "200": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Error" } } },
      "create": { "summary": "Create a resource", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Json" }, "responses": { "201": { "$ref": "#/components/responses/Json" }, "202": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Error" } } },
      "update": { "summary": "Update a resource", "requestBody": { "$ref": "#/components/requestBodies/Json" }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Error" } } },
      "delete": { "summary": "Delete a resource", "responses": { "204": { "description": "Deleted" }, "default": { "$ref": "#/components/responses/Error" } } },
      "publicGet": { "summary": "Read a published resource", "responses": { "200": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Error" } } },
      "publicList": { "summary": "List published resources", "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Error" } } },
      "publicCreate": { "summary": "Create or submit a public resource", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Json" }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "201": { "$ref": "#/components/responses/Json" }, "202": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Error" } } },
      "publicDelete": { "summary": "Remove a public subscription", "responses": { "200": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Error" } } },
      "portalUpdate": { "summary": "Update customer profile or communication preferences", "requestBody": { "$ref": "#/components/requestBodies/Json" }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "requestBodies": {
      "Json": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }
    },
    "responses": {
      "Json": { "description": "JSON response", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } },
      "Error": { "description": "The standard Hubchat error envelope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Id": { "type": "string", "pattern": "^[a-z][a-z0-9]*_[0-9a-z]+$", "description": "Opaque prefixed Hubchat identifier; never parse it." },
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "$ref": "#/components/schemas/ErrorBody" } } },
      "ErrorBody": { "type": "object", "required": ["code", "message", "request_id"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "request_id": { "$ref": "#/components/schemas/Id" }, "details": { "type": "object", "additionalProperties": true } } },
      "Page": { "type": "object", "required": ["data", "has_more", "next_cursor"], "properties": { "data": { "type": "array", "items": {} }, "has_more": { "type": "boolean" }, "next_cursor": { "type": ["string", "null"] } } },
      "EventEnvelope": { "type": "object", "required": ["id", "type", "workspace_id", "occurred_at", "sequence", "data"], "properties": { "id": { "$ref": "#/components/schemas/Id" }, "type": { "type": "string" }, "workspace_id": { "$ref": "#/components/schemas/Id" }, "occurred_at": { "type": "string", "format": "date-time" }, "sequence": { "type": "integer", "format": "int64" }, "data": { "type": "object", "additionalProperties": true } } }
    }
  }
}
