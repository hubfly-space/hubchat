# Hubchat configuration.
#
# Copy to .env for local development. Every value here matches the defaults in
# docker-compose.yml, so `make dev-db && cp .env.example .env && make dev`
# gives a working stack.
#
# Only the first three are required — see internal/config/config.go, whose
# Validate() reports every problem at once rather than the first one.

# ---------------------------------------------------------------- required

# PostgreSQL. The only hard runtime dependency (§8.1).
HUBCHAT_DATABASE_URL=postgres://hubchat:hubchat@localhost:5432/hubchat?sslmode=disable

# How browsers reach this instance. Used for cookie scope, widget origin
# checks, and links in outbound email — a wrong value here breaks all three.
HUBCHAT_PUBLIC_URL=http://localhost:8080

# At least 32 bytes. Signs session cookies, visitor tokens, and customer
# identity tokens (§11.5). Generate with:  openssl rand -base64 48
# This example value is public and must never be used outside local dev.
HUBCHAT_SECRET_KEY=dev-only-insecure-key-replace-me-with-openssl-rand-base64-48

# ---------------------------------------------------------------- server

HUBCHAT_LISTEN=:8080
# http, realtime, worker, scheduler — or a subset to run role-specific
# processes (§8.5). Default runs all of them in one process.
HUBCHAT_ROLES=http,realtime,worker,scheduler
# verify | apply | skip. `apply` is convenient locally; production should
# migrate explicitly with `hubchat migrate` and run with `verify`.
HUBCHAT_MIGRATE=apply
# 1 serves assets from disk and disables caching, so the Vite dev server wins.
HUBCHAT_DEV=1

# ---------------------------------------------------------------- storage

HUBCHAT_DATA_DIR=./data/files

# Uncomment to exercise the S3 adapter against the MinIO container instead of
# local disk. Leave commented for the default single-binary experience.
# HUBCHAT_STORAGE_BACKEND=s3
# HUBCHAT_S3_ENDPOINT=http://localhost:9000
# HUBCHAT_S3_REGION=us-east-1
# HUBCHAT_S3_BUCKET=hubchat
# HUBCHAT_S3_ACCESS_KEY=hubchat
# HUBCHAT_S3_SECRET_KEY=hubchat-dev-secret
# HUBCHAT_S3_PATH_STYLE=1

# ---------------------------------------------------------------- email

# Points at the MailHog container. Read what was sent at http://localhost:8025.
HUBCHAT_SMTP_HOST=localhost
HUBCHAT_SMTP_PORT=1025
HUBCHAT_SMTP_FROM=hubchat@localhost
# MailHog accepts anything, so no username/password and no TLS.
# HUBCHAT_SMTP_USERNAME=
# HUBCHAT_SMTP_PASSWORD=

# ---------------------------------------------------------------- member SSO

# Optional deployment-level member sign-in. Built-in profiles are google and
# microsoft; omit endpoint variables for those profiles. Use generic for an
# arbitrary OIDC/OAuth provider and set all three HTTPS endpoints.
# HUBCHAT_OAUTH_PROVIDER=google
# HUBCHAT_OAUTH_PROFILE=google
# HUBCHAT_OAUTH_CLIENT_ID=
# HUBCHAT_OAUTH_CLIENT_SECRET=
# HUBCHAT_OAUTH_AUTHORIZATION_URL=
# HUBCHAT_OAUTH_TOKEN_URL=
# HUBCHAT_OAUTH_USERINFO_URL=
# HUBCHAT_OAUTH_SCOPES=openid,email,profile
# HUBCHAT_OAUTH_ALLOWED_DOMAINS=example.com

# ---------------------------------------------------------------- observability

HUBCHAT_LOG_FORMAT=text
HUBCHAT_LOG_LEVEL=debug
